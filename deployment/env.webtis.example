APP_NAME=SCIEM
APP_VERSION=VERSION_RELEASE
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://polarissoft.tis.cs.umss.edu.bo

LOG_CHANNEL=errorlog
LOG_LEVEL=warning
LOG_DAILY_DAYS=14
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=polarissoft_db
DB_USERNAME=polarissoft
DB_PASSWORD=

CACHE_DRIVER=database
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=database
VIEW_CACHE_PRIVATE_TEMP=true
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
SESSION_COOKIE=polarissoft_session

# Cambiar a smtp y completar sus datos antes de validar envíos reales.
MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=SCIEM

